WHITESPACE = _{ " " | "\t" }
NEWLINE    = _{ "\n" | "\r\n" | "\r" }

id      = @{ ASCII_ALPHANUMERIC ~ (ASCII_ALPHANUMERIC | "_" | "-" | ":")* }
tier    =  { ^"CRITICAL" | ^"PERSONAL" | ^"NOISE" }
payload = @{ (!NEWLINE ~ ANY)+ }

write_stmt  = { ^"WRITE"  ~ id ~ ^"TIER" ~ tier ~ payload ~ (^"AUTO" ~ ^"EMBED")? }
auto_embed_stmt = { ^"AUTO" ~ ^"EMBED" ~ id }
read_stmt   = { ^"READ"   ~ id }
list_stmt   = { ^"LIST"   ~ (^"TIER" ~ tier)? }
delete_stmt = { ^"DELETE" ~ id }
audit_stmt  = { ^"AUDIT"  ~ id? }

embed_stmt  = { ^"EMBED"  ~ id ~ vector }
search_stmt = { ^"SEARCH" ~ vector ~ ^"LIMIT" ~ number ~ (^"SIMILARITY" ~ ^">" ~ float)? }
vector      = @{ "[" ~ float ~ ("," ~ WHITESPACE* ~ float)* ~ "]" }
number      = @{ ASCII_DIGIT+ }
float       = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }

statement = _{ write_stmt | read_stmt | list_stmt | delete_stmt | audit_stmt | embed_stmt | search_stmt | auto_embed_stmt }
program   =  { SOI ~ WHITESPACE* ~ statement ~ WHITESPACE* ~ EOI }
