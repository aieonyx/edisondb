{
  "name": "edisondb",
  "version": "0.1.0-alpha.2",
  "description": "The official TypeScript/JavaScript SDK for EdisonDB — sovereign, AI-native, encrypted database",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "keywords": ["database", "encryption", "sovereignty", "embedded", "rust"],
